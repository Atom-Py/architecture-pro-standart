@startuml task3-c4-containers
!include <C4/C4_Container>

title Диаграмма контейнеров (C4, уровень 2) - подача заявки на депозит онлайн, MVP

Person(visitor, "Потенциальный клиент", "Посетитель сайта.")
Person(client, "Клиент банка", "Пользователь интернет-банка.")
Person(op_cc, "Оператор кол-центра", "Обрабатывает заявки с сайта.")
Person(bo_dep, "Менеджер бэк-офиса депозитов", "Обрабатывает заявки и открывает депозиты.")
Person(bo_cred, "Менеджер бэк-офиса кредитов", "Ведёт базовые ставки.")
Person(front, "Сотрудник фронт-офиса", "Идентифицирует нового клиента и оформляет депозит в отделении.")

System_Boundary(site_b, "Сайт банка") {
  Container(site_app, "Веб-приложение сайта", "PHP", "Маркетинговые страницы, существующая система.")
  Container(site_spa, "Витрина депозитов и форма заявки", "React.js", "Новое: список продуктов со ставками и форма заявки для неавторизованного посетителя.")
}

System_Boundary(ib_b, "Интернет-банк") {
  Container(ib_app, "Веб-приложение интернет-банка", "ASP.NET MVC 4.5, .NET Framework 4.5", "Монолит на платформе подрядчика: платежи, счета, аутентификация. Ядро не дорабатывается.")
  ContainerDb(ib_db, "БД интернет-банка", "MS SQL", "Данные монолита.")
  Container(ib_spa, "Веб-модуль «Депозиты»", "React.js", "Новое: раздел депозитов, встроенный в личный кабинет, работает через шлюз, минуя ядро.")
}

System_Boundary(dep_b, "Платформа депозитов (новая система)") {
  Container(gw, "API Gateway", "YARP, .NET 8", "Единая точка входа для сайта и интернет-банка: TLS, балансировка, лимиты запросов, проверка сессии клиента.")
  Container(dep_svc, "Сервис депозитных продуктов", "ASP.NET Core, .NET 8", "Витрина ставок, персональные ставки, приём заявок, статусы, защита от дублей.")
  ContainerDb(dep_db, "БД депозитных продуктов", "MS SQL", "Витрина ставок, заявки, статусы, журнал действий.")
  Container(notify, "Сервис уведомлений и одноразовых кодов", "ASP.NET Core, .NET 8", "Выпуск и проверка кода подтверждения, отправка СМС по событиям. Заменяет доработку ядра интернет-банка.")
  ContainerDb(notify_db, "БД уведомлений", "MS SQL", "Коды подтверждения, история отправок.")
  ContainerQueue(kafka, "Шина событий", "Kafka", "Топики ставок, заявок и статусов. Развёрнута в двух ЦОД.")
  Container(abs_adapter, "Интеграционный адаптер АБС", "Java, Spring Boot", "Читает исходящие события из таблиц обмена Oracle и публикует в Kafka, принимает заявки из Kafka и пишет во входящие таблицы.")
}

System_Boundary(abs_b, "АБС") {
  Container(abs_client, "Десктоп-клиент АБС", "Delphi", "Рабочее место фронт-офиса и бэк-офиса.")
  Container(abs_rates, "Модуль ведения ставок", "PL/SQL, экранные формы", "Новое: базовые и индивидуальные ставки, согласование по заявке, разграничение прав депозитов и кредитов.")
  Container(abs_appl, "Модуль обработки заявок на депозит", "PL/SQL, экранные формы", "Доработка: очередь заявок из digital-каналов, подтверждение условий, открытие депозита.")
  Container(abs_core, "Ядро учёта", "PL/SQL", "Счета, депозиты, договоры, проводки. Не изменяется.")
  ContainerDb(abs_db, "БД АБС", "Oracle", "Данные банка и таблицы обмена: входящие заявки и исходящие события.")
}

System_Boundary(cc_b, "Система кол-центра") {
  Container(cc_adapter, "Адаптер заявок", "Java, Spring Boot", "Новое: подписывается на топик заявок и создаёт обращение оператору.")
  Container(cc_core, "Ядро системы кол-центра", "Java Spring Boot, React.js, PostgreSQL", "Микросервисы платформы подрядчика, рабочее место оператора.")
}

System_Ext(sms, "СМС-шлюз", "Отправка СМС, поддерживается IT-отделом банка.")
System_Ext(telecom, "Телеком-оператор", "Внешний сервис доставки СМС.")

Rel(visitor, site_app, "Открывает страницы банка", "HTTPS")
Rel(site_app, site_spa, "Отдаёт витрину и форму заявки")
Rel(site_spa, gw, "Запрашивает ставки, отправляет заявку", "HTTPS, REST")

Rel(client, ib_app, "Входит в личный кабинет", "HTTPS")
Rel(ib_app, ib_db, "Читает и пишет данные монолита", "TDS")
Rel(ib_app, ib_spa, "Открывает раздел депозитов")
Rel(ib_spa, gw, "Запрашивает ставки, отправляет заявку, подтверждает кодом", "HTTPS, REST")
Rel(gw, ib_app, "Проверяет сессию клиента", "HTTPS, REST")

Rel(gw, dep_svc, "Маршрутизирует запросы витрины и заявок", "HTTPS, REST")
Rel(gw, notify, "Запрашивает и проверяет одноразовый код", "HTTPS, REST")
Rel(dep_svc, dep_db, "Читает и пишет", "TDS")
Rel(notify, notify_db, "Читает и пишет", "TDS")
Rel(dep_svc, kafka, "Публикует поданные заявки, читает ставки и статусы", "Kafka")
Rel(notify, kafka, "Читает события для уведомлений", "Kafka")
Rel(notify, sms, "Отправляет СМС", "HTTPS")
Rel(sms, telecom, "Передаёт сообщения", "Протокол оператора")
Rel(telecom, client, "Доставляет СМС", "Сеть оператора")

Rel(abs_adapter, kafka, "Публикует ставки и статусы, читает заявки", "Kafka")
Rel(abs_adapter, abs_db, "Работает с таблицами обмена", "JDBC")
Rel(kafka, cc_adapter, "Передаёт заявки с сайта", "Kafka")
Rel(cc_adapter, cc_core, "Создаёт обращение по заявке", "REST")
Rel(op_cc, cc_core, "Обрабатывает обращение, видит ставки")

Rel(bo_dep, abs_client, "Работает с заявками и депозитами")
Rel(bo_cred, abs_client, "Ведёт базовые ставки")
Rel(front, abs_client, "Идентифицирует клиента, оформляет депозит в отделении")
Rel(abs_client, abs_rates, "Вызывает процедуры ведения и согласования ставок", "Oracle Net")
Rel(abs_client, abs_appl, "Вызывает процедуры обработки заявок", "Oracle Net")
Rel(abs_rates, abs_db, "Пишет ставки и события", "PL/SQL")
Rel(abs_appl, abs_db, "Читает заявки, пишет статусы и события", "PL/SQL")
Rel(abs_appl, abs_core, "Открывает депозит и договор", "PL/SQL")
Rel(abs_core, abs_db, "Читает и пишет", "PL/SQL")

SHOW_LEGEND()
@enduml
