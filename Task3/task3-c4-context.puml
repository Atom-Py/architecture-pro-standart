@startuml task3-c4-context
!include <C4/C4_Context>

title Диаграмма контекста (C4, уровень 1) - подача заявки на депозит онлайн, MVP

Person(visitor, "Потенциальный клиент", "Посетитель сайта, ещё не является клиентом банка и не идентифицирован.")
Person(client, "Клиент банка", "Пользуется интернет-банком, идентифицирован.")
Person(op_cc, "Оператор кол-центра", "Перезванивает по заявкам с сайта, предлагает особые условия.")
Person(bo_dep, "Менеджер бэк-офиса депозитов", "Обрабатывает заявки, согласует индивидуальные ставки, открывает депозит.")
Person(bo_cred, "Менеджер бэк-офиса кредитов", "Ведёт базовые ставки на основе ключевой ставки ЦБ и уровня кредитного риска.")
Person(front, "Сотрудник фронт-офиса", "Идентифицирует нового клиента, пришедшего в отделение по итогам заявки с сайта.")

System(site, "Сайт банка", "Витрина продуктов и форма заявки на депозит для неавторизованных посетителей.")
System(ib, "Интернет-банк", "Личный кабинет клиента: платежи, счета, новый раздел депозитов.")
System(deposits, "Платформа депозитов", "Новая система: витрина ставок, приём и хранение заявок, уведомления и одноразовые коды, шина событий.")
System(abs, "АБС", "Учёт операций и счетов, ведение ставок, обработка заявок, открытие депозитов и договоров.")
System(cc, "Система кол-центра", "Рабочее место оператора, обращения по заявкам с сайта.")
System(sms, "СМС-шлюз", "Отправка СМС в сеть телеком-оператора.")

System_Ext(telecom, "Телеком-оператор", "Внешний сервис доставки СМС абоненту.")

Rel(visitor, site, "Смотрит ставки, оставляет заявку на депозит", "HTTPS")
Rel(client, ib, "Смотрит персональные ставки, подаёт заявку, подтверждает её кодом из СМС", "HTTPS")

Rel(site, deposits, "Запрашивает витрину ставок, передаёт заявку", "HTTPS, REST")
Rel(ib, deposits, "Запрашивает витрину и персональные ставки, передаёт заявку, запрашивает код подтверждения", "HTTPS, REST")

Rel_D(deposits, cc, "Передаёт заявки с сайта для обратного звонка", "Kafka")
BiRel(deposits, abs, "Передаёт заявки на обработку, получает ставки и статусы", "Kafka через адаптер")
Rel(deposits, sms, "Отправляет уведомления и одноразовые коды", "HTTPS")
Rel(sms, telecom, "Передаёт сообщения", "Протокол оператора")
Rel(telecom, client, "Доставляет СМС", "Сеть оператора")

Rel(op_cc, cc, "Работает с обращениями, видит актуальные ставки")
Rel(bo_dep, abs, "Обрабатывает заявки, согласует ставку, открывает депозит")
Rel(bo_cred, abs, "Ведёт базовые ставки и параметры кредитного риска")
Rel(front, abs, "Идентифицирует клиента, оформляет депозит в отделении")

SHOW_LEGEND()
@enduml
