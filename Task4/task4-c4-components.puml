@startuml task4-c4-components
!include <C4/C4_Component>

title Диаграмма компонентов (C4, уровень 3) - публикация ставок в кол-центр банка и партнёру

ContainerQueue_Ext(kafka, "Шина событий", "Kafka", "Топик изменений ставок, наполняется адаптером АБС.")

Container_Boundary(pub, "Сервис публикации ставок (платформа депозитов, ASP.NET Core, .NET 8)") {
  Component(consumer, "Потребитель событий ставок", "Kafka consumer", "Читает топик ставок, проверяет версию и порядок сообщений, обновляет локальный набор актуальных ставок.")
  Component(store, "Реестр актуальных ставок", "Репозиторий, MS SQL", "Хранит текущий срез ставок и историю версий, отдаёт срез на заданный момент.")
  Component(scheduler, "Планировщик публикации", "Quartz.NET", "Запускает выгрузку при изменении ставок и по расписанию: гарантированная публикация после утверждения ставок на день.")
  Component(builder, "Формирователь файла", "CSV, UTF-8", "Формирует полный срез ставок, манифест с контрольной суммой и номером версии.")
  Component(sender, "Отправитель файла", "SSH.NET", "Кладёт файл и манифест в каталог партнёра на SFTP-сервере, пишет результат в журнал.")
  Component(control, "Контроль доставки", "Фоновая задача", "Следит, что файл сформирован и забран партнёром, при нарушении срока отправляет оповещение.")
  Component(rates_api, "API ставок", "REST", "Отдаёт актуальные ставки по запросу, используется как резервный канал и для сверки.")
}

ContainerDb_Ext(pub_db, "БД платформы депозитов", "MS SQL", "Реестр ставок, журнал публикаций.")
Container_Ext(sftp, "SFTP-сервер банка", "SFTP в демилитаризованной зоне", "Каталог партнёра, доступ по ключу, файлы хранятся ограниченное время.")
System_Ext(pcc, "Система партнёрского кол-центра", "Забирает файл по расписанию, загружает ставки к себе.")
System_Ext(monitoring, "Мониторинг и оповещения", "Метрики и алерты IT-отдела.")

Container_Boundary(cc_ad, "Адаптер системы кол-центра (Java, Spring Boot)") {
  Component(cc_consumer, "Потребитель ставок", "Kafka consumer", "Подписан на топик ставок, применяет изменения к локальной витрине.")
  Component(cc_store, "Локальная витрина ставок", "Репозиторий, PostgreSQL", "Хранит актуальные ставки внутри контура системы кол-центра.")
  Component(cc_api, "Внутренний API ставок", "REST", "Отдаёт ставки интерфейсу оператора.")
  Component(cc_fallback, "Резервный запрос ставок", "REST client", "Если поток событий отстал, запрашивает срез у платформы депозитов.")
}

Container_Ext(cc_ui, "Рабочее место оператора", "React.js", "Карточка обращения с блоком актуальных ставок.")
Person(op_cc, "Оператор кол-центра банка", "Консультирует клиента по телефону.")
Person(admin, "Дежурный IT-отдела", "Разбирает инциденты публикации, при необходимости запускает выгрузку повторно.")

Rel(kafka, consumer, "События изменения ставок", "Kafka")
Rel(consumer, store, "Обновляет срез ставок")
Rel(store, pub_db, "Читает и пишет", "TDS")
Rel(scheduler, builder, "Запускает формирование файла")
Rel(consumer, scheduler, "Сообщает об изменении ставок")
Rel(builder, store, "Запрашивает актуальный срез")
Rel(builder, sender, "Передаёт файл и манифест")
Rel(sender, sftp, "Кладёт файл в каталог партнёра", "SFTP")
Rel(sender, pub_db, "Пишет журнал публикаций", "TDS")
Rel(control, pub_db, "Проверяет журнал публикаций")
Rel(control, sftp, "Проверяет, забран ли файл", "SFTP")
Rel(control, monitoring, "Отправляет метрики и оповещения", "HTTPS")
Rel(monitoring, admin, "Оповещает о сбое публикации или о том, что файл не забран")
Rel(admin, scheduler, "Запускает повторную публикацию файла", "Служебный интерфейс")
Rel(pcc, sftp, "Забирает файл и манифест по расписанию", "SFTP")
Rel(rates_api, store, "Читает актуальный срез")

Rel(kafka, cc_consumer, "События изменения ставок", "Kafka")
Rel(cc_consumer, cc_store, "Применяет изменения")
Rel(cc_api, cc_store, "Читает ставки")
Rel(cc_fallback, rates_api, "Запрашивает срез ставок при отставании", "HTTPS, REST")
Rel(cc_fallback, cc_store, "Восстанавливает витрину")
Rel(cc_ui, cc_api, "Запрашивает ставки для карточки обращения", "HTTPS, REST")
Rel(op_cc, cc_ui, "Смотрит ставки во время звонка")

SHOW_LEGEND()
@enduml
