@startuml task4-c4-context
!include <C4/C4_Context>

title Диаграмма контекста (C4, уровень 1) - передача актуальных ставок в кол-центры

Person(caller, "Клиент или потенциальный клиент", "Звонит, чтобы уточнить условия по депозиту.")
Person(op_cc, "Оператор кол-центра банка", "200 сотрудников, консультирует по продуктам.")
Person(op_pcc, "Оператор партнёрского кол-центра", "100 сотрудников внешней организации.")
Person(bo_cred, "Менеджер бэк-офиса кредитов", "Ведёт базовые ставки в АБС.")
Person(bo_dep, "Менеджер бэк-офиса депозитов", "Согласует индивидуальные условия.")
Person(admin, "Дежурный IT-отдела", "Контролирует доставку файла партнёру.")

System(abs, "АБС", "Источник ставок: модуль ведения ставок и события об их изменении.")
System(deposits, "Платформа депозитов", "Витрина ставок, публикация ставок в каналы и выгрузка файла для партнёра.")
System(cc, "Система кол-центра", "Рабочее место оператора банка, показывает актуальные ставки в карточке обращения.")
System(sftp, "Файловый обмен банка", "SFTP-сервер в демилитаризованной зоне, каталог партнёра.")

System_Ext(pcc, "Система партнёрского кол-центра", "Внешняя система, API-вызовы к банку недоступны, принимает только файлы.")

Rel(bo_cred, abs, "Ведёт базовые ставки")
Rel(bo_dep, abs, "Согласует индивидуальные условия")
Rel(abs, deposits, "Публикует события об изменении ставок", "Kafka через адаптер")
Rel(deposits, cc, "Передаёт актуальные ставки", "Kafka")
Rel(deposits, sftp, "Выкладывает файл ставок и манифест", "SFTP")
Rel(pcc, sftp, "Забирает файл ставок по расписанию", "SFTP")

Rel(caller, op_cc, "Звонит в кол-центр банка")
Rel(caller, op_pcc, "Звонит в партнёрский кол-центр")
Rel(op_cc, cc, "Смотрит актуальные ставки в карточке обращения")
Rel(op_pcc, pcc, "Смотрит ставки, загруженные из файла")
Rel(admin, deposits, "Получает оповещения о сбоях публикации, запускает повторную выгрузку")

SHOW_LEGEND()
@enduml
