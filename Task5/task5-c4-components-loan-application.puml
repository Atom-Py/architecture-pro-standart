@startuml task5-c4-components-loan-application
!include <C4/C4_Component>

title Диаграмма компонентов (C4, уровень 3) - сервис кредитных заявок

Container_Ext(gw, "API Gateway", "YARP, .NET 8", "Единая точка входа для сайта и интернет-банка, ограничение частоты запросов.")
ContainerQueue_Ext(kafka, "Шина событий", "Kafka", "Топики заявок, статусов и условий продуктов.")

Container_Boundary(loan, "Сервис кредитных заявок (ASP.NET Core, .NET 8)") {
  Component(api, "API заявок и условий", "REST", "Отдаёт условия кредитов, принимает заявки из сайта и интернет-банка, отдаёт статусы.")
  Component(guard, "Контроль обращений", "Middleware", "Проверка на автоматизированные обращения, лимиты по клиенту и каналу, ограничение числа обращений в бюро кредитных историй, ключ идемпотентности против дублей заявок.")
  Component(catalog, "Витрина кредитных продуктов", "Репозиторий, MS SQL", "Условия продуктов, полученные событиями из Кредитного конвейера.")
  Component(registry, "Реестр заявок", "Репозиторий, MS SQL", "Сквозной идентификатор заявки для всех каналов, состав данных, статусы, журнал действий.")
  Component(matcher, "Поиск существующей заявки", "Доменный сервис", "Ищет ранее поданную заявку по паспорту и номеру телефона, нормализует данные, возвращает кандидатов для подтверждения сотрудником отделения.")
  Component(state, "Модель состояний заявки", "Доменный сервис", "Переходы: черновик, подтверждена кодом, отправлена в конвейер, предварительно одобрена, решение принято, отказ.")
  Component(scoring_client, "Клиент системы скоринга", "REST client", "Синхронный запрос предварительного решения с таймаутом и предохранителем. При отказе или превышении лимита заявка уходит на обычную обработку.")
  Component(publisher, "Публикация событий", "Outbox, Kafka producer", "Публикует поданные заявки и изменения статусов без потерь.")
  Component(status_consumer, "Потребитель статусов", "Kafka consumer", "Принимает статусы из Кредитного конвейера и обновляет реестр заявок.")
}

ContainerDb_Ext(db, "БД сервиса кредитных заявок", "MS SQL", "Заявки, витрина условий, журнал действий, таблица исходящих событий.")
Container_Ext(offer_api, "API предодобренных предложений", "REST", "Действующее предложение по клиенту.")
Container_Ext(notify, "Сервис уведомлений и одноразовых кодов", "ASP.NET Core, .NET 8", "Выпуск и проверка кода подтверждения, СМС о статусе заявки. Переиспользуется из решения по депозитам.")
Container_Ext(abs_ad, "Интеграционный адаптер АБС", "Java, Spring Boot", "Расширяется: кроме обмена через таблицы Oracle обращается к сервису заявок по запросу сотрудника отделения.")
System_Ext(scoring, "Система кредитного скоринга", "Python, Flask REST API. Скоринг нового клиента по общим данным бюро кредитных историй.")

Rel(gw, api, "Запросы витрины, подачи заявок и статусов", "HTTPS, REST")
Rel(abs_ad, api, "Ищет ранее поданную заявку по паспорту и телефону, создаёт заявку из отделения. Синхронный вызов: сотрудник ждёт ответа при клиенте", "HTTPS, REST")
Rel(api, notify, "Запрашивает выпуск и проверку одноразового кода при подаче заявки", "HTTPS, REST")
Rel(api, guard, "Проверяет обращение и повторность")
Rel(api, catalog, "Читает условия продуктов")
Rel(api, registry, "Создаёт и читает заявки")
Rel(api, matcher, "Ищет ранее поданную заявку клиента")
Rel(api, state, "Переводит заявку между состояниями")
Rel(api, offer_api, "Проверяет наличие предодобренного предложения", "HTTPS, REST")
Rel(api, scoring_client, "Запрашивает предварительное решение, если заполнены паспортные данные")
Rel(scoring_client, scoring, "Скоринг по общим данным бюро кредитных историй", "HTTPS, REST")
Rel(matcher, registry, "Читает заявки по паспорту и телефону")
Rel(registry, db, "Читает и пишет", "TDS")
Rel(catalog, db, "Читает и пишет", "TDS")
Rel(publisher, db, "Читает таблицу исходящих событий", "TDS")
Rel(publisher, kafka, "Публикует заявки и изменения статусов", "Kafka")
Rel(kafka, status_consumer, "Статусы обработки заявок и обновления условий продуктов", "Kafka")
Rel(status_consumer, registry, "Обновляет статус заявки")
Rel(status_consumer, catalog, "Обновляет условия продуктов")

SHOW_LEGEND()
@enduml
