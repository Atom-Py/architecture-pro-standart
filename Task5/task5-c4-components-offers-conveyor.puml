@startuml task5-c4-components-offers-conveyor
!include <C4/C4_Component>

title Диаграмма компонентов (C4, уровень 3) - предодобренные предложения и передача заявок в Кредитный конвейер

ContainerQueue_Ext(kafka, "Шина событий", "Kafka", "Топики заявок, статусов, условий продуктов и выполненных скорингов.")
Container_Ext(loan_api, "Сервис кредитных заявок", "ASP.NET Core, .NET 8", "Принимает заявки и запрашивает действующее предложение по клиенту.")

Container_Boundary(offers, "Сервис предодобренных предложений (ASP.NET Core, .NET 8)") {
  Component(score_consumer, "Потребитель результатов скоринга", "Kafka consumer", "Читает события о скорингах, которые уже были выполнены по другим поводам. Дополнительных расчётов не инициирует.")
  Component(offer_builder, "Формирователь предложения", "Доменный сервис", "По результату скоринга рассчитывает сумму, ставку и срок действия предложения.")
  Component(offer_store, "Реестр предложений", "Репозиторий, MS SQL", "Действующие предложения по клиентам и история их изменения.")
  Component(expiry, "Контроль срока действия", "Фоновая задача", "Снимает предложения с истёкшим сроком, чтобы клиент не видел устаревшие условия.")
  Component(offer_api, "API предложений", "REST", "Отдаёт действующее предложение по клиенту в интернет-банк и сервису заявок.")
}

Container_Boundary(conv_ad, "Адаптер Кредитного конвейера (Java, Spring Boot)") {
  Component(appl_consumer, "Потребитель заявок", "Kafka consumer", "Читает поданные заявки и запускает по ним процесс обработки, минуя суточный обмен через АБС.")
  Component(camunda_client, "Клиент Camunda", "REST client", "Создаёт экземпляр процесса и передаёт данные заявки, включая признак предодобренной для приоритетной обработки.")
  Component(status_producer, "Публикация статусов и условий", "Kafka producer", "Отдаёт изменения статусов заявок и обновления условий продуктов в шину.")
}

System_Ext(conveyor, "Кредитный конвейер", "Camunda BPM, Oracle. Обработка заявок, полные условия продуктов, повторный упрощённый скоринг.")
System_Ext(scoring, "Система кредитного скоринга", "Python, Flask REST API. Публикует событие о каждом выполненном скоринге.")
System_Ext(abs_ad, "Интеграционный адаптер АБС", "Java, Spring Boot. Передаёт в АБС одобренные заявки для зачисления средств. Поиск заявки по клиенту из отделения выполняется отдельным синхронным вызовом сервиса заявок.")
System_Ext(notify, "Сервис уведомлений и одноразовых кодов", "ASP.NET Core, .NET 8. СМС о смене статуса заявки.")

Rel(scoring, kafka, "Сообщает о выполненном скоринге", "Kafka")
Rel(kafka, score_consumer, "События о выполненных скорингах", "Kafka")
Rel(score_consumer, offer_builder, "Передаёт результат скоринга")
Rel(offer_builder, offer_store, "Сохраняет предложение")
Rel(expiry, offer_store, "Снимает предложения с истёкшим сроком")
Rel(offer_api, offer_store, "Читает действующее предложение")
Rel(loan_api, offer_api, "Запрашивает предложение по клиенту", "HTTPS, REST")

Rel(kafka, appl_consumer, "Поданные заявки", "Kafka")
Rel(appl_consumer, camunda_client, "Передаёт данные заявки")
Rel(camunda_client, conveyor, "Создаёт экземпляр процесса обработки", "REST")
Rel(conveyor, status_producer, "Сообщает об изменении статуса и об обновлении условий продуктов", "Обработчик на Java")
Rel(status_producer, kafka, "Публикует статусы и условия", "Kafka")
Rel(conveyor, scoring, "Повторный упрощённый скоринг при обработке заявки", "HTTPS, REST")

Rel(kafka, abs_ad, "Одобренные заявки для зачисления средств", "Kafka")
Rel(kafka, notify, "События смены статуса заявки", "Kafka")

SHOW_LEGEND()
@enduml
