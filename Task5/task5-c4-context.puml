@startuml task5-c4-context
!include <C4/C4_Context>

title Диаграмма контекста (C4, уровень 1) - подача заявки на кредит на сайте и в интернет-банке

Person(visitor, "Потенциальный клиент", "Посетитель сайта, не идентифицирован, данных о нём в банке нет.")
Person(client, "Клиент банка", "Пользователь интернет-банка, по нему есть внутренняя история.")
Person(manager, "Менеджер отделения", "Оформляет заявку в АБС, идентифицирует клиента, выдаёт кредит.")
Person(officer, "Сотрудник управления кредитных продуктов", "Обрабатывает заявки в Кредитном конвейере и принимает решение.")

System(site, "Сайт банка", "Витрина кредитных предложений и форма заявки для неавторизованного посетителя.")
System(ib, "Интернет-банк", "Личный кабинет: условия по кредитам, предодобренное предложение, подача заявки.")
System(platform, "Цифровая платформа", "Развитие платформы депозитов из решения MVP. Добавляются сервис кредитных заявок и сервис предодобренных предложений, шлюз, шина событий и сервис уведомлений переиспользуются.")
System(abs, "АБС", "Учёт клиентов и счетов, оформление заявки в отделении, зачисление кредитных средств.")
System(conveyor, "Кредитный конвейер", "Обработка заявок, полные условия кредитных продуктов, принятие решения.")
System(scoring, "Система кредитного скоринга", "Расчёт рейтинга клиента и допустимой суммы кредита.")
System(sms, "СМС-шлюз", "Отправка сообщений клиенту.")

System_Ext(bki, "Бюро кредитных историй", "Внешняя система, данные кредитной истории по запросу.")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС абоненту.")

Rel(visitor, site, "Смотрит условия, подаёт заявку, при заполнении паспортных данных получает предварительное решение", "HTTPS")
Rel(client, ib, "Смотрит условия и предодобренное предложение, подаёт заявку, подтверждает кодом из СМС", "HTTPS")
Rel(site, platform, "Запрашивает условия, передаёт заявку", "HTTPS, REST")
Rel(ib, platform, "Запрашивает условия и предложение, передаёт заявку", "HTTPS, REST")

Rel(platform, scoring, "Запрашивает предварительное решение по новому клиенту", "HTTPS, REST")
Rel(scoring, bki, "Запрашивает кредитную историю", "HTTPS, REST")
Rel(scoring, platform, "Сообщает о выполненных скорингах", "Kafka")
BiRel(platform, conveyor, "Передаёт заявки на обработку, получает условия продуктов и статусы", "REST и Kafka через адаптер")
Rel(conveyor, scoring, "Запрашивает скоринг при обработке заявки", "HTTPS, REST")
BiRel(platform, abs, "Отдаёт заявку по клиенту в отделении синхронно, передаёт одобренные заявки на зачисление средств событиями", "REST и Kafka через адаптер")

Rel(platform, sms, "Отправляет уведомления о статусе заявки и одноразовые коды", "HTTPS")
Rel(sms, telecom, "Передаёт сообщения", "Протокол оператора")
Rel(telecom, client, "Доставляет СМС", "Сеть оператора")

Rel(manager, abs, "Оформляет заявку, продолжает работу с онлайн-заявкой клиента")
Rel(officer, conveyor, "Обрабатывает заявки и принимает решение")

SHOW_LEGEND()
